$ cat sssd.conf
# /etc/sssd/sssd.conf  (owner root:root, mode 0600)
# Requires SSSD 2.11.0 or later with the idp provider (Debian forky or sid).
[sssd]
services = nss, pam, ssh
domains = entra

[nss]
default_shell = /bin/bash
fallback_homedir = /home/%u

[pam]
# Users finish the device code sign in on another device.
pam_id_timeout = 5

[domain/entra]
id_provider = idp
auth_provider = idp
access_provider = simple
idp_type = entra_id

idp_client_id = 11111111-1111-1111-1111-111111111111
idp_client_secret = ci-placeholder

idp_token_endpoint = https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/token
idp_device_auth_endpoint = https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/devicecode
idp_userinfo_endpoint = https://graph.microsoft.com/v1.0/me

# Application scope used by SSSD itself to look up users and groups.
idp_id_scope = https://graph.microsoft.com/.default
# Delegated scope used during the user's device code sign in.
idp_auth_scope = openid profile email

idp_request_timeout = 10
idp_auto_refresh = true

# Deterministic POSIX IDs derived from Entra object IDs.
idmap_range_min = 200000
idmap_range_max = 2000200000
idmap_range_size = 200000

# Only members of this Entra group may log in.
simple_allow_groups = linux-admins

cache_credentials = false
enumerate = false
use_fully_qualified_names = true
