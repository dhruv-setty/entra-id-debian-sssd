$ docker exec forky grep PRETTY_NAME /etc/os-release
PRETTY_NAME="Debian GNU/Linux forky/sid"
$ docker exec forky dpkg-query -W sssd-common sssd-idp
sssd-common	2.13.1-5
sssd-idp	2.13.1-5
$ docker exec forky iato render --env /root/entra-app.env --group linux-admins --out /etc/sssd/sssd.conf
